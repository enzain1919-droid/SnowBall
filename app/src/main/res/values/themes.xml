<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LongRunPortfolio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
    </style>
    <style name="Theme.LongRunPortfolio.Light" parent="Theme.LongRunPortfolio">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.LongRunPortfolio.Dark" parent="Theme.LongRunPortfolio">
        <item name="android:windowBackground">@color/launch_background_dark</item>
        <item name="android:colorBackground">@color/launch_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
